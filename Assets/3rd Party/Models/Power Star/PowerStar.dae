                    </bind_material>
                </instance_controller>
            </node>
            <node id="jointnode-1" name="root" sid="jointnode-1" type="JOINT">
                <node id="jointnode0" name="PowerStar" sid="jointnode0" type="JOINT">
                    <node id="jointnode1" name="PowerStarC" sid="jointnode1" type="JOINT">
                    </node>
                    <node id="jointnode2" name="PowerStarE" sid="jointnode2" type="JOINT">
                    </node>
                </node>
            </node>
        </visual_scene>
    </library_visual_scenes>
    <scene>
        <instance_visual_scene url="#VisualSceneNode"></instance_visual_scene>
    </scene>
</COLLADA>
