  lines:
  - characterName: "Guardi\xE0"
    text: Bones Edgar, has aconseguit escapar la primera prova, enhorabona.
    guardianAnimationTrigger: Talk
    overrideGuardianPosition: 1
    guardianPosition: {x: 9.127, y: 0.436, z: 11.807}
    overrideGuardianRotation: 0
    guardianRotation: {x: 0, y: 0, z: 0}
  - characterName: "Guardi\xE0"
    text: "Ara el teu dest\xED es triar\xE0, <br>haur\xE0s de estirar de la palanca
      que veus aqui."
    guardianAnimationTrigger: Talk
    overrideGuardianPosition: 0
    guardianPosition: {x: 0, y: 0, z: 0}
    overrideGuardianRotation: 0
    guardianRotation: {x: 0, y: 0, z: 0}
  - characterName: "Guardi\xE0"
    text: "Per estirar-la, prem el click dret<br> sobre la bolla vermella<br> y arrossega
      el ratol\xED d'adalt a abaix"
    guardianAnimationTrigger: Talk
    overrideGuardianPosition: 0
    guardianPosition: {x: 0, y: 0, z: 0}
    overrideGuardianRotation: 0
    guardianRotation: {x: 0, y: 0, z: 0}
